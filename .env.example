# Set these in the shell or your process manager; npm start does not auto-load this file.
INVENTORY_MODE=demo
CATALOGUE_DB=private-data/catalogue.sqlite
PORT=8787
# HOST=127.0.0.1
# Curated source-link research, distinct from approved inventory. No post bodies.
RESEARCH_LINKS_ENABLED=0
RESEARCH_DB=private-data/forum-crawl.sqlite
RESEARCH_LINKS_MANIFEST=private-data/research-links.json
# Local development defaults to memory. Vercel requires supabase.
SESSION_BACKEND=memory
# Server-only runtime settings; never use VITE_ prefixes for credentials.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# The setup wizard stores local deployment credentials in ignored .env.deployment.
# CI secrets: VERCEL_TOKEN, VERCEL_ORG_ID, VERCEL_PROJECT_ID,
# SUPABASE_ACCESS_TOKEN, SUPABASE_PROJECT_REF, SUPABASE_DB_PASSWORD.
